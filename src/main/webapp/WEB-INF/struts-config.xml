<!DOCTYPE struts-config PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
        "http://struts.apache.org/dtds/struts-config_1_3.dtd">
<struts-config>

    <action-mappings>

        <action path="/addTask" type="com.example.action.AddTaskAction">
            <forward name="view" path="/viewTasks.do"/>
        </action>

        <action path="/viewTasks" type="com.example.action.ViewTaskAction">
            <forward name="success" path="/tasks.jsp"/>
        </action>

        <action path="/deleteTask" type="com.example.action.DeleteTaskAction">
            <forward name="view" path="/viewTasks.do"/>
        </action>

        <action path="/updateTask" type="com.example.action.UpdateTaskAction">
            <forward name="view" path="/viewTasks.do"/>
        </action>

    </action-mappings>

</struts-config>